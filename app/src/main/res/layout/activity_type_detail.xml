<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/title_type_detail"
            app:titleTextColor="@color/on_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_type_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                style="@style/SectionLabel"
                android:layout_marginStart="2dp"
                android:text="@string/section_pool_manage" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/et_new_item"
                    style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/pool_input_hint"
                    android:inputType="text"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_add_item"
                    style="@style/SmallButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/add" />

                <ImageButton
                    android:id="@+id/btn_batch_import"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/batch_import"
                    android:src="@drawable/ic_import"
                    app:tint="@color/primary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_pool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_pool_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/empty_pool_detail"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                style="@style/SectionLabel"
                android:layout_marginStart="2dp"
                android:text="@string/section_usage" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_usage_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/empty_usage"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
