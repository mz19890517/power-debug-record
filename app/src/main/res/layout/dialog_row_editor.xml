<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 自动排序选项 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/row_editor_auto_sort"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="8dp" />

        <android.widget.RadioGroup
            android:id="@+id/rg_sort_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_sort_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_custom_row"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="40dp" />

            <RadioButton
                android:id="@+id/rb_sort_name_asc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_name_asc"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="40dp" />

            <RadioButton
                android:id="@+id/rb_sort_name_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_name_desc"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="40dp" />

            <RadioButton
                android:id="@+id/rb_sort_fault_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_fault_desc"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="40dp" />

            <RadioButton
                android:id="@+id/rb_sort_test_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_test_desc"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:minHeight="40dp" />
        </android.widget.RadioGroup>

        <!-- 行分配区域（仅自定义模式显示） -->
        <TextView
            android:id="@+id/tv_row_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/row_editor_hint"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/row_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
