<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/title_planned_manage"
            app:titleTextColor="@color/on_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/tv_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp">

        <EditText
            android:id="@+id/et_new_item"
            style="@style/FormInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="@string/planned_input_hint"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_add_item"
            style="@style/SmallButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/add" />

        <ImageButton
            android:id="@+id/btn_sync_pool"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sync_from_pool"
            android:src="@drawable/ic_import"
            app:tint="@color/primary" />
    </LinearLayout>

    <!-- 候选池联想：输入时展示包含输入文字的候选项，点选回填避免重复添加（动态行由代码渲染） -->
    <LinearLayout
        android:id="@+id/box_cand_suggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_planned"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_planned_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/empty_planned"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
