<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅在使用 WebDAV 同步功能时产生网络访问；不集成任何第三方SDK -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.App">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.device.ProjectDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.device.TypeDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.test.PlannedManageActivity"
            android:exported="false" />

        <activity
            android:name=".ui.test.CandidatePickerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.test.TestChecklistActivity"
            android:exported="false" />
    </application>

</manifest>
